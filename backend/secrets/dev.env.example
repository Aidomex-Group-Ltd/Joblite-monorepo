# Core development secrets (Joblite.Repo, JWT signing).
# Gitignored. Generated by backend/scripts/generate_secrets.sh.
#
# DATABASE_URL points at the compose.yaml PostgreSQL instance on 127.0.0.1:5543.
# The credentials are the documented local-only defaults from compose.yaml.
DATABASE_URL=ecto://joblite:joblite_local_only@localhost:5543/joblite_dev_db
# 64 random bytes from openssl, hex encoded.
JWT_SECRET=replace-with-openssl-generated-hex
