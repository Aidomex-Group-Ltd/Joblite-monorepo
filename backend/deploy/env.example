# Runtime configuration for the Joblite release (placeholders only).
#
# Copy to .env (gitignored) and fill in real values. Never commit real values,
# certificates or passwords; never pass secrets as docker build arguments.
#
# The isolated verification stack (compose.yaml) supplies the database URL,
# CA mount, PHX_HOST and PORT itself; only SECRET_KEY_BASE is read from .env
# there. A real deployment supplies every value below at runtime.

# PostgreSQL connection.
# DATABASE_SSL selects the transport policy:
#   require (default) - TLS without certificate pinning, for managed
#     platforms that do not ship a CA file (e.g. Render managed PostgreSQL).
#   verify-full - TLS with certificate pinning; requires DATABASE_CA_CERT to
#     exist in the container and DATABASE_SSL_SERVER_NAME below.
#   disable - plain TCP, local experiments only, never production.
# With verify-full the server certificate must match
# DATABASE_SSL_SERVER_NAME.
#
# Supabase: use the Session Pooler connection string copied from the
# Dashboard "Connect" panel (host like
# aws-0-<region>.pooler.supabase.com, port 5432, user
# postgres.<project-ref>). Do NOT use the direct db.<project-ref>.supabase.co
# host: it resolves to IPv6 only and is not reachable from Render, so Postgrex
# fails with "non-existing domain - :nxdomain" before any TLS or password
# check. The pooler host resolves to IPv4 and is the supported path.
# With the pooler, set DATABASE_SSL_SERVER_NAME to the pooler hostname.
DATABASE_URL=ecto://USER:PASSWORD@DATABASE_HOST:5432/DATABASE_NAME
DATABASE_SSL=require
# Only with DATABASE_SSL=verify-full: mount the bundle (for example as a
# secret file) and point at the mounted path.
# DATABASE_CA_CERT=/path/to/ca-certificate.pem
# DATABASE_SSL_SERVER_NAME=database-hostname.example.com
POOL_SIZE=5

# The core image (backend/Dockerfile) reads the variables above only: it
# serves no traffic and signs no session. PHX_HOST, PORT and SECRET_KEY_BASE
# below belong to the browser-facing release.

# Phoenix endpoint.
# SECRET_KEY_BASE: generate with `bin/joblite gen.secret` (or
# `mix phx.gen.secret`); minimum 64 random bytes.
SECRET_KEY_BASE=replace-with-generated-secret-key-base
PHX_HOST=joblite.example.com
PORT=4000
